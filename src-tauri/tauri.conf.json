{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiverLab Crypto Lab 6A",
  "mainBinaryName": "riverlab-6a",
  "version": "0.6.0-alpha.1",
  "identifier": "org.riverlab.cryptolab.prototype6a",
  "build": {
    "beforeBuildCommand": "npm run build:desktop-6a",
    "frontendDist": "../work/desktop-6a/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RiverLab Crypto Lab · Phase 6A 验证原型",
        "create": false,
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; worker-src 'self'; connect-src 'self' ipc: https://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "prototype-checks",
          "description": "Run the synthetic SQLite check and submit evidence during an isolated native acceptance run.",
          "windows": ["main"],
          "permissions": ["allow-verify-sqlite", "allow-qa-record"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/riverlab.ico"],
    "publisher": "RiverLab",
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
