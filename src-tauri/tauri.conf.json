{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiverLab Crypto Lab",
  "mainBinaryName": "riverlab-desktop",
  "version": "0.6.1",
  "identifier": "org.riverlab.crypto-lab.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:desktop-6a",
    "frontendDist": "../work/desktop-6a/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RiverLab Crypto Lab",
        "create": false,
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; worker-src 'self'; connect-src 'self' ipc: https://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "desktop-local-service",
          "description": "Access local research records and service diagnostics from the bundled main window.",
          "windows": ["main"],
          "permissions": [
            "allow-local-service-health",
            "allow-local-service-integrity",
            "allow-local-service-backup",
            "allow-repository-handshake",
            "allow-repository-command",
            "allow-repository-upload-chunk",
            "allow-repository-read-chunk",
            "allow-verify-sqlite",
            "allow-qa-record",
            "allow-save-report-download"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/riverlab.ico"],
    "publisher": "RiverLab",
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
